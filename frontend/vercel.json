{
  "version": 2,
  "outputDirectory": "dist/stock-recommender-frontend/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://stock-recommender-app-backend.vercel.app/api/:path*"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
