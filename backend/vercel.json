{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "instruments.csv",
          "fonts/Outfit.ttf",
          "fonts/PlusJakartaSans.ttf"
        ],
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/premarket-instagram",
      "schedule": "30 1 * * *"
    }
  ]
}
